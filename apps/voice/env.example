# Copy to apps/voice/.env for a local run (never committed). The vendor keys and the LiveKit
# project belong to the operator; in development they live outside the repo, e.g.
# ~/.config/va/voice.env, sourced with `set -a; source ~/.config/va/voice.env; set +a`.
# Every setting is documented in docs/VOICE.md → Settings; the defaults are Landmark's measured values.

# Dispatch-only agent name: the API dispatches to it (VOICE_AGENT_NAME there, default va-voice)
AGENT_NAME=va-voice

# LiveKit Cloud EU project
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
VOICE_ID=pTD8166KADi6ZFJ5FEXi

# Model and data (the same values as apps/api/.env)
ANTHROPIC_API_KEY=
SUPABASE_URL=http://127.0.0.1:54431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_VOICE_MODEL=
AI_VOICE_EFFORT=

# Tuning (Landmark's measured defaults; change only with a measurement)
ENDPOINT_LATENCY_LEVEL=3
ENDPOINT_DELAY_MS=500
TURN_MIN_DELAY_MS=100
INTERRUPT_ON=vad
INTERRUPT_MIN_MS=50
OUTPUT_QUEUE_MS=50
VAD_THRESHOLD=0.3
VAD_MIN_SPEECH_MS=30
IDENTITY_CACHE_MS=60000
# VOICE_LOGS_DIR=apps/voice/logs
