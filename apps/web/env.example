# Copy to apps/web/.env (git-ignored). Every variable the PWA reads, inlined by Vite at build time
# (`apps/web/src/lib/env.ts`; docs/OPS.md → Env matrix); nothing else is read anywhere.

# Supabase: the local stack prints these in `supabase status`; a hosted project in its dashboard.
# The anon key is public; RLS is the boundary.
VITE_SUPABASE_URL=http://127.0.0.1:54431
VITE_SUPABASE_ANON_KEY=

# The API's origin, no trailing slash (the dev server's default port is 3000).
VITE_API_URL=http://localhost:3000
