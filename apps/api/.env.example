# Copy to apps/api/.env (git-ignored). Every variable the API reads; nothing else is read anywhere.

# Port to listen on.
PORT=3000

# Supabase: the local stack prints these in `supabase status`; a hosted project in its dashboard.
SUPABASE_URL=http://127.0.0.1:54431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. ANTHROPIC_BASE_URL only for a local proxy or the test fakes; leave empty otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model overrides (empty keeps the channel defaults: Opus 5.5 / medium for chat, Sonnet 5.5 / low for voice).
AI_CHAT_MODEL=
AI_CHAT_EFFORT=
AI_VOICE_MODEL=
AI_VOICE_EFFORT=

# LiveKit Cloud (EU). All three or none: without them POST /voice/sessions answers 500 internal_error.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent name the voice worker registers with; the dispatch targets it.
VOICE_AGENT_NAME=va-voice

# Comma-separated browser origins allowed by CORS, or * (development only).
CORS_ORIGINS=*
