# Copy to apps/api/.env (git-ignored). Every variable the API reads; nothing else is read anywhere.

# Port to listen on.
PORT=3000

# Supabase: the local stack prints these in `supabase status`; a hosted project in its dashboard.
SUPABASE_URL=http://127.0.0.1:54431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. ANTHROPIC_BASE_URL only for a local proxy or the test fakes; leave empty otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model overrides (empty keeps the channel defaults: Opus 5.5 / medium for chat, Sonnet 5.5 / low for voice).
AI_CHAT_MODEL=
AI_CHAT_EFFORT=
AI_VOICE_MODEL=
AI_VOICE_EFFORT=

# LiveKit Cloud (EU). All three or none: without them POST /voice/sessions answers 500 internal_error.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The agent name the voice worker registers with; the dispatch targets it.
VOICE_AGENT_NAME=va-voice

# Comma-separated browser origins allowed by CORS, or * (development only).
CORS_ORIGINS=*

# Microsoft 365 (Outlook connection, docs/MAIL.md). All six or none: without them GET /integrations
# says not available and the connect routes answer 503 integration_unavailable.
# Tenant and client id from the Entra app registration (Overview); the secret from Certificates & secrets.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Exactly the redirect URI registered in Entra.
MS_REDIRECT_URI=http://localhost:3000/integrations/microsoft/callback
# printf 'k1:%s\n' "$(openssl rand -base64 32)"   (rotate: new key first, old after a comma)
INTEGRATIONS_KEY=
# The PWA's origin; the callback sends the browser back to its /settings.
WEB_APP_URL=http://localhost:5173
