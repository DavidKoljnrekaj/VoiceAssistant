    "@va/core": "workspace:*",
    "@va/db": "workspace:*",
    "@va/tools-demo": "workspace:*",
    "hono": "4.13.13",
    "livekit-server-sdk": "2.19.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
