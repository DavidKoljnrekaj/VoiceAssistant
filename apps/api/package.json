{
  "name": "@va/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono HTTP API: /chat (SSE), /sessions, /voice/sessions, /health",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
